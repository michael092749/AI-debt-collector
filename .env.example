# Copy to .env and fill in. Steps 1-8 of the build run fine with this file absent.

# Conversation model (Tier-2 adversarial evals + real agent reasoning)
ANTHROPIC_API_KEY=

# Voice pipeline (step 9 only). STT, TTS, and — with COLLECTOR_LLM=livekit —
# the conversation model all run on LiveKit Inference, so these three
# credentials are the whole pipeline; no Deepgram or Cartesia key is needed.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
