# Copy to .env and fill in. Steps 1-8 of the build run fine with this file absent.

# Conversation model (Tier-2 adversarial evals + real agent reasoning)
ANTHROPIC_API_KEY=

# Voice pipeline (step 9 only). STT, TTS, and — with COLLECTOR_LLM=livekit —
# the conversation model all run on LiveKit Inference, so these three
# credentials are the whole pipeline; no Deepgram or Cartesia key is needed.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Audit log. COLLECTOR_DB_PATH overrides the CWD-relative data/collector.db —
# set it to a path on the encrypted volume (README, "Storage and retention").
# COLLECTOR_RETENTION_DAYS is what `collector-purge` deletes against; the
# default of 1095 is the Regulation F three-year floor, so shortening it is a
# records-retention decision, not a disk-space one.
COLLECTOR_DB_PATH=
COLLECTOR_RETENTION_DAYS=

# Trace export. Unset or `off` — the default — creates no spans at all. The
# only other accepted value is `otlp`, and anything else is refused at start-up
# rather than read as "off": a typo that silently disables observability is
# discovered at the moment you go looking for the one call you needed.
#
# `otlp` requires OTEL_EXPORTER_OTLP_ENDPOINT — the exporter's own default is
# localhost, so a mode set without one would black-hole every span. Point the
# two OTEL_ variables at any OTLP/HTTP backend; for Langfuse that is
# https://cloud.langfuse.com/api/public/otel with
# `Authorization=Basic <base64 of public_key:secret_key>`.
#
# Span attributes leave this process for a third party. Nothing that identifies
# a consumer goes on one — no transcript, no name, no dollar figure. See
# src/collector/tracing.py for exactly what does.
COLLECTOR_TRACING=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
